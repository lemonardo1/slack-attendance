{
  "compatibility_date": "2025-04-01",
  "main": "src/index.ts",
  "name": "slack-attendance",
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "your-database-id-here",
      "database_name": "your-database-name"
    }
  ],
  "vars": {
    "SLACK_SIGNING_SECRET": "",
    "ADMIN_PASSWORD": "",
    "SLACK_WEBHOOK_URL": "",
    "WORKER_URL": "",
    "GOOGLE_CLIENT_ID": "",
    "GOOGLE_CLIENT_SECRET": "",
    "GOOGLE_REDIRECT_URI": "",
    "GOOGLE_REDIRECT_URI_LOCAL": "http://localhost:8787/stats/auth/google/callback",
    "GOOGLE_ALLOWED_DOMAIN": "",
    "GEMINI_API_KEY": ""
  },
  "triggers": {
    "crons": ["0 0 * * 6", "0 19 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
